parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type list\<string\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Shell/Shell.php

		-
			message: '#^Parameter \#1 \$string of function trim expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/Shell/Shell.php

		-
			message: '#^Call to an undefined static method Posternak\\Commandeer\\Builders\\Cmd\:\:docker\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: tests/Unit/Builders/CmdTest.php

		-
			message: '#^Call to an undefined static method Posternak\\Commandeer\\Builders\\Cmd\:\:someExecutable\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: tests/Unit/Builders/CmdTest.php

		-
			message: '#^Cannot call method __someOption\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Unit/Builders/CmdTest.php

		-
			message: '#^Cannot call method info\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Unit/Builders/CmdTest.php

		-
			message: '#^Cannot call method someCommand\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Unit/Builders/CmdTest.php
